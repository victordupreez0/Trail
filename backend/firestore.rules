rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The assignment ships with one shared demo administrator. Production code would
    // use custom claims or an Admin SDK-managed role document instead.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@gmail.com';
    }

    match /users/{uid} {
      allow read, write: if isSelf(uid);

      match /savedTrails/{trailId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /trails/{trailId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /trailRecommendations/{recommendationId} {
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Mirrors {code: groupId} outside the member-read-only groups collection. A
    // joiner is by definition not yet a member, so a query on groups by inviteCode
    // would be denied before it returns anything; this is the fix.
    match /inviteCodes/{code} {
      function ownsReferencedGroup() {
        return isSignedIn()
          && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only the group's owner can flip a code inactive (endGroup), and only that
      // field may move; the groupId a code points at never changes.
      allow update: if ownsReferencedGroup()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }

      function joiningSelf() {
        // Only the caller's own uid may be appended to memberIds; every other
        // field must stay exactly as it was.
        let before = resource.data;
        let after = request.resource.data;
        return isSignedIn()
          && after.diff(before).affectedKeys().hasOnly(['memberIds'])
          && after.memberIds.toSet().difference(before.memberIds.toSet()).hasOnly([request.auth.uid]);
      }

      allow read: if isMember();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || joiningSelf();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /positions/{uid} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow write: if isSelf(uid) && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }
  }
}
